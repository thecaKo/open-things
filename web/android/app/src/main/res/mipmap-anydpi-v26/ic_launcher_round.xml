<?xml version="1.0" encoding="utf-8"?>
<!-- Mascot on the splash colour. The foreground vector keeps the mascot inside
     the adaptive-icon safe zone, so no extra inset. Legacy PNGs (API < 26) are
     generated from web/assets/ with @capacitor/assets. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_bg" />
    <foreground android:drawable="@drawable/ic_launcher_mascot" />
</adaptive-icon>
