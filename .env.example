# Public hostname pointing at the VM (A record). Caddy gets the HTTPS cert automatically.
# No domain? Use a free one like <your-ip-with-dashes>.sslip.io, e.g. 129-146-1-2.sslip.io
DOMAIN=things.example.com

# Shared secret for all your devices. Generate with: openssl rand -hex 24
OPEN_THINGS_TOKEN=
